{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the editor window may do. No file system, dialog or opener access from the page: paths are chosen and used in Rust, so nothing the page sends can name a file.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-startup",
    "allow-set-dirty",
    "allow-new-document",
    "allow-open-dialog",
    "allow-open-recent",
    "allow-open-pending",
    "allow-save",
    "allow-save-as",
    "allow-export-pdf",
    "allow-close-window",
    "allow-write-recovery",
    "allow-render",
    "allow-recent-files",
    "allow-clear-recent",
    "allow-presets",
    "allow-defaults",
    "allow-theme-mode",
    "allow-set-theme-mode"
  ]
}
