#include <winresrc.h>

// The manifest has to be resource id 1 of type RT_MANIFEST for an .exe.
1 RT_MANIFEST "app.manifest"

// Explorer shows the lowest-numbered icon group, so the app icon takes id 1
// too - a different resource type, so it does not collide with the manifest.
// Generated by tools/make_icon.py; do not hand-edit the .ico.
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 0, 0
PRODUCTVERSION 2, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CV Builder"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "CVBuilder"
            VALUE "OriginalFilename", "CVBuilder.exe"
            VALUE "ProductName", "CV Builder"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
