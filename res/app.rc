#include <winresrc.h>

#include "version.h"

// The manifest has to be resource id 1 of type RT_MANIFEST for an .exe.
1 RT_MANIFEST "app.manifest"

// Explorer shows the lowest-numbered icon group, so the app icon takes id 1
// too - a different resource type, so it does not collide with the manifest.
// Generated by tools/make_icon.py; do not hand-edit the .ico.
1 ICON "app.ico"

// The strings below surface in the Details tab of the file properties, in the
// task manager, and in the tooltip Explorer shows for the executable. The
// language block is Russian (0x419) with the Unicode code page (1200), to
// match the interface the program actually speaks.
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_FILEVERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Редактор резюме с экспортом в PDF"
            VALUE "FileVersion", VER_VERSION_STR
            VALUE "InternalName", "CVBuilder"
            VALUE "OriginalFilename", "CVBuilder.exe"
            VALUE "ProductName", VER_PRODUCT
            VALUE "ProductVersion", VER_VERSION_STR
            VALUE "CompanyName", VER_COMPANY
            VALUE "LegalCopyright", VER_COPYRIGHT
            VALUE "Comments", "Редактирование резюме с живым предпросмотром и вёрсткой A4-PDF. Win32 и Direct2D, без внешних зависимостей."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
